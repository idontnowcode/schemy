{
  "name": "ai-circuit-studio-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI Circuit Studio desktop shell (Electron + React)",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "dompurify": "3.4.17",
    "electron": "45.2.2",
    "electron-builder": "26.0.12",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "author": "AI Circuit Studio",
  "build": {
    "appId": "com.aicircuitstudio.desktop",
    "productName": "AI Circuit Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "ui"
      },
      {
        "from": "../build/backend/aics-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AI Circuit Studio",
      "artifactName": "AI-Circuit-Studio-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development"
    }
  }
}
