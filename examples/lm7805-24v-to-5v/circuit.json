  "decisions": [
    {
      "id": "dec-ic",
      "topic": "레귤레이터 IC",
      "choice": "L7805 (TO-220, KiCad Regulator_Linear:L7805)",
      "by": "requirement",
      "reason": "요청한 IC 그대로 썼습니다. 핀은 KiCad 심볼 기준 1=IN, 2=GND, 3=OUT입니다. TO-220 수직 풋프린트는 방열판을 달기 쉬워 골랐습니다(방열 필요성은 아래 결정 참고).",
      "request": "24 to 5 dcdc 회로설계. 사용ic는 7805. 위 조건을 만족하는 회로를 그려보고 회로 이미지를 보내줘",
      "source": "ST L78 시리즈 데이터시트 — 핀 배치, 응용 회로",
      "components": [
        "u-reg"
      ]
    },
    {
      "id": "dec-topology",
      "topic": "회로 방식 (DC-DC 요청)",
      "choice": "리니어 레귤레이터 회로",
      "by": "changed",
      "reason": "요청은 'DC-DC'였지만, 지정한 7805는 스위칭 DC-DC가 아니라 리니어 레귤레이터입니다. 요청한 IC로는 스위칭 변환을 할 수 없어 IC 지정을 우선해 리니어로 구성했습니다. 대신 전압 차이 × 전류가 그대로 열이 되므로 발열을 회로도 주석과 리포트에 밝혔습니다. 수백 mA 이상이 필요하면 앱의 '5V 벅 컨버터 (LM2596S-5)' 템플릿 같은 스위칭 방식을 권합니다.",
      "request": "24 to 5 dcdc 회로설계. 사용ic는 7805. 위 조건을 만족하는 회로를 그려보고 회로 이미지를 보내줘",
      "calc": "손실 P = (Vin − 5 V) × Iout",
      "components": [
        "u-reg"
      ]
    },
    {
      "id": "dec-vin",
      "topic": "입력 전압",
      "choice": "24 V, 2핀 단자대 J1",
      "by": "requirement",
      "reason": "요청한 입력 전압입니다. L7805(출력 5~18 V형)의 최대 입력 35 V 안에 들어갑니다.",
      "request": "24 to 5 dcdc 회로설계. 사용ic는 7805. 위 조건을 만족하는 회로를 그려보고 회로 이미지를 보내줘",
      "source": "ST L78 시리즈 데이터시트 — 절대 최대 정격(입력 전압). 쪽 번호는 원문 확인 필요",
      "components": [
        "j-in"
      ]
    },
    {
      "id": "dec-iout",
      "topic": "출력 전류 (가정)",
      "choice": "약 100 mA",
      "by": "ai",
      "reason": "요청에 출력 전류가 없어서 가정했습니다. 리니어 방식은 전류에 비례해 발열이 커지므로 낮게 잡았습니다. 실제 부하 전류로 다시 계산해야 합니다. 이 값은 회로의 +5V Net 부하 전류(0.1 A)로 적어 두어, 기술 검토가 같은 값으로 레귤레이터 발열과 D1 전류를 계산합니다. +24V Net은 D1 강하를 뺀 23.1 V, PWR_IN은 24 V로 적었습니다.",
      "calc": "P = (23.1 V − 5 V) × 0.1 A ≈ 1.8 W (D1 강하 0.9 V 반영)",
      "components": [
        "u-reg"
      ]
    },
    {
      "id": "dec-heat",
      "topic": "방열",
      "choice": "방열판 필요 (100 mA에서도)",
      "by": "ai",
      "reason": "방열판 없는 TO-220은 접합-주변 열저항이 약 50 °C/W라서, 1.8 W면 주변보다 약 90 °C 올라갑니다. 방열판 없이 쓰려면 수십 mA 이하로 제한해야 합니다.",
      "calc": "ΔT ≈ 1.8 W × 50 °C/W ≈ 90 °C",
      "source": "ST L78 시리즈 데이터시트 — 열 특성(Rthj-amb, TO-220). 쓰는 제조사 데이터시트로 확인",
      "components": [
        "u-reg"
      ]
    },
    {
      "id": "dec-d1",
      "topic": "역전압 보호",
      "choice": "1N4007 직렬 (D1)",
      "by": "ai",
      "reason": "요청에는 없지만 24 V 단자대는 극성을 바꿔 꽂기 쉬워, 레귤레이터와 전해 콘덴서를 보호하려고 넣었습니다. 약 0.9 V 강하는 입출력 차(약 18 V)에 비해 작습니다. P채널 MOSFET 방식보다 손실은 크지만 부품이 단순합니다.",
      "calc": "Vin ≈ 24 V − 0.9 V = 23.1 V",
      "components": [
        "d-rev"
      ]
    },
    {
      "id": "dec-cin",
      "topic": "입력 콘덴서",
      "choice": "330 nF/50 V 세라믹(C2) + 100 µF/50 V 전해(C1)",
      "by": "ai",
      "reason": "330 nF는 데이터시트 응용 회로의 입력 0.33 µF(전원 필터와 떨어져 있을 때 필요)입니다. 100 µF는 배선 인덕턴스와 전원 리플에 대비한 벌크입니다. 정격 50 V는 24 V의 2배 이상입니다.",
      "calc": "50 V / 24 V ≈ 2.1배",
      "source": "ST L78 시리즈 데이터시트 — 응용 회로(입력 0.33 µF)",
      "components": [
        "c-in2",
        "c-in"
      ]
    },
    {
      "id": "dec-cout",
      "topic": "출력 콘덴서",
      "choice": "100 nF 세라믹(C3) + 47 µF/16 V 전해(C4)",
      "by": "ai",
      "reason": "100 nF는 데이터시트 응용 회로의 출력 0.1 µF(과도 응답 개선)입니다. 47 µF는 부하 변동용 벌크입니다. 16 V 정격은 5 V의 3배입니다.",
      "calc": "16 V / 5 V = 3.2배",
      "source": "ST L78 시리즈 데이터시트 — 응용 회로(출력 0.1 µF)",
      "components": [
        "c-out2",
        "c-out"
      ]
    },
    {
      "id": "dec-d2",
      "topic": "출력 방전 보호",
      "choice": "1N4001 (D2, 출력 → 입력)",
      "by": "ai",
      "reason": "입력이 단락되면 C4(47 µF)의 전하가 레귤레이터 출력에서 입력 쪽으로 역류할 수 있습니다. 다이오드로 방전 경로를 만들어 레귤레이터를 보호합니다.",
      "source": "78xx 계열 데이터시트의 보호 다이오드 응용(출력 용량이 클 때). 쪽 번호는 원문 확인 필요",
      "components": [
        "d-prot"
      ]
    },
    {
      "id": "dec-led",
      "topic": "전원 표시 LED",
      "choice": "1 kΩ + 녹색 LED (R1, D3)",
      "by": "ai",
      "reason": "요청에는 없지만 5 V 출력 확인용으로 넣었습니다. 약 2~3 mA면 표시에 충분하고 발열은 무시할 수 있습니다.",
      "calc": "I = (5 V − Vf 2.0~3.2 V) / 1 kΩ ≈ 1.8~3 mA",
      "components": [
        "r-led",
        "d-led"
      ]
    },
    {
      "id": "dec-terminal",
      "topic": "입출력 단자",
      "choice": "5 mm 피치 2핀 단자대 (J1, J2)",
      "by": "ai",
      "reason": "요청에 형태가 없어, 24 V 전원 배선을 나사로 단단히 고정할 수 있는 단자대를 골랐습니다.",
      "components": [
        "j-in",
        "j-out"
      ]
    }
  ]
