{
  "$defs": {
    "Component": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "reference": {
          "pattern": "^[A-Z]+[0-9]+$",
          "title": "Reference",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "symbol_id": {
          "description": "KiCad symbol, e.g. 'Device:R'.",
          "pattern": "^[A-Za-z0-9_.\\-]+:[^:\\s]+$",
          "title": "Symbol Id",
          "type": "string"
        },
        "footprint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "KiCad footprint, e.g. 'Resistor_SMD:R_0603_1608Metric'.",
          "title": "Footprint Id"
        },
        "manufacturer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maker of the exact part, e.g. 'Texas Instruments'. With the MPN it identifies the part for datasheet lookups.",
          "title": "Manufacturer"
        },
        "manufacturer_part_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer Part Number"
        },
        "pins": {
          "items": {
            "$ref": "#/$defs/Pin"
          },
          "minItems": 1,
          "title": "Pins",
          "type": "array"
        },
        "pin_map_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "origin": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the part came from: 'template:<id>@<version>' for a part placed from a reviewed template, 'ai' for a part an AI design chose, None for parts entered by hand or imported.",
          "title": "Origin"
        }
      },
      "required": [
        "id",
        "reference",
        "value",
        "symbol_id",
        "pins"
      ],
      "title": "Component",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "One design choice and why it was made, kept with the circuit so a reviewer can follow every choice: a part,\na value, an added protection, a topology. Decisions never change connectivity.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "topic": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "choice": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "by": {
          "enum": [
            "requirement",
            "changed",
            "ai",
            "template",
            "engineer"
          ],
          "title": "By",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The user's words this answers.",
          "title": "Request"
        },
        "calc": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The calculation behind a value.",
          "title": "Calc"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Datasheet (document, section, page), standard or reference used.",
          "title": "Source"
        },
        "components": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "id",
        "topic",
        "choice",
        "by",
        "reason"
      ],
      "title": "Decision",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a pin map or rating came from.",
      "properties": {
        "status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "unverified"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Datasheet, library, or review reference.",
          "title": "Source"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Evidence",
      "type": "object"
    },
    "Net": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_+\\-]+$",
          "title": "Name",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NetNode"
          },
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "nodes"
      ],
      "title": "Net",
      "type": "object"
    },
    "NetNode": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Component Id",
          "type": "string"
        },
        "pin": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Pin",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "pin"
      ],
      "title": "NetNode",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "description": "A short line of text drawn on the schematic: what a block is and its key spec (\"555 astable,\n~1 Hz\"), or what a net carries (\"555 output, 1 Hz square wave\"). Notes never change connectivity.\n\nWith ``components`` the note goes next to those parts; with ``net`` next to that net's label; with\nneither, at the top of the first page. Write notes in English so they read the same in every tool.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$",
          "title": "Text",
          "type": "string"
        },
        "components": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        },
        "net": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_+\\-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Net"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Note",
      "type": "object"
    },
    "Pin": {
      "additionalProperties": false,
      "description": "A physical pin of a component, keyed by the symbol's pin number.",
      "properties": {
        "number": {
          "maxLength": 16,
          "minLength": 1,
          "title": "Number",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected pin name in the KiCad symbol (evidence only; checked against the library, never used for connectivity).",
          "title": "Name"
        },
        "no_connect": {
          "default": false,
          "description": "Intentionally left unconnected; the schematic gets a no-connect marker on this pin.",
          "title": "No Connect",
          "type": "boolean"
        }
      },
      "required": [
        "number"
      ],
      "title": "Pin",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "Schematic position of a symbol origin, in millimetres (KiCad sheet coords).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "description": "Counter-clockwise degrees: 0/90/180/270.",
          "title": "Rotation",
          "type": "integer"
        },
        "mirror": {
          "default": false,
          "description": "Mirrored left-right on the sheet after the rotation (KiCad 'mirror y'). KiCad's 'mirror x' is the same as this plus a 180 degree turn.",
          "title": "Mirror",
          "type": "boolean"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Placement",
      "type": "object"
    },
    "Sheet": {
      "additionalProperties": false,
      "description": "One page of a board's schematic. Pages only group components for drawing;\nnets stay board-wide, so moving a component to another page never changes connectivity.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "pattern": "^[^/\\\\:*?\\\"<>|]+$",
          "title": "Name",
          "type": "string"
        },
        "components": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Sheet",
      "type": "object"
    },
    "Validation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/VerificationStatus",
          "default": "unverified"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "title": "Validation",
      "type": "object"
    },
    "VerificationStatus": {
      "description": "Plan FR-11: unverified / needs review / verified (by an engineer).",
      "enum": [
        "unverified",
        "needs_review",
        "verified"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.7.0",
      "title": "Schema Version",
      "type": "string"
    },
    "project_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/Component"
      },
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "nets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Net"
      },
      "title": "Nets",
      "type": "array"
    },
    "sheets": {
      "default": [],
      "description": "Pages in order. Empty means one page. Components not listed go on the first page.",
      "items": {
        "$ref": "#/$defs/Sheet"
      },
      "title": "Sheets",
      "type": "array"
    },
    "layout": {
      "description": "Optional placement per component id (on its page); kept apart from connectivity.",
      "patternProperties": {
        "^[a-z0-9][a-z0-9._-]*$": {
          "$ref": "#/$defs/Placement"
        }
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1
      },
      "title": "Layout",
      "type": "object"
    },
    "notes": {
      "default": [],
      "description": "Short English notes drawn on the schematic (block captions, net descriptions).",
      "items": {
        "$ref": "#/$defs/Note"
      },
      "title": "Notes",
      "type": "array"
    },
    "decisions": {
      "default": [],
      "description": "Design choices and their reasons (who decided, calculation, source), for review.",
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "validation": {
      "$ref": "#/$defs/Validation"
    }
  },
  "required": [
    "project_id",
    "components"
  ],
  "title": "CircuitIR",
  "type": "object"
}
